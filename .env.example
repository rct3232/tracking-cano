# RTSP 설정
RTSP_URL=rtsp://admin:admin@192.168.0.100:554/stream

# LLM API 설정
API_BASE_URL=https://api.openai.com/v1
API_KEY=your_api_key_here
MODEL_NAME=gpt-4o-mini

# go2rtc 서버 주소 (생략 시 RTSP/파일 경로 직접 사용)
GO2RTC_URL=http://localhost:1984

# PyTorch C++ 로그 레벨 (ERROR=NNPACK 경고 억제, INFO=모든 경고 출력)
TORCH_CPP_LOG_LEVEL=ERROR

# 움직임 감지 민감도
SPEED_SLOW=20.0
SPEED_FAST=40.0
DASH_THRESHOLD=15.0
ROTATION_THRESHOLD=45.0
HYSTERESIS=5.0
MIN_FRAMES=3

# YOLO 감지 설정
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.70

# 타일링 감지 설정 (전체화면 감지 실패 시 폴백)
TILE_ENABLED=1
TILE_GRID_X=2
TILE_GRID_Y=2
TILE_OVERLAP=20
