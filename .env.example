# RTSP 설정
RTSP_URL=rtsp://admin:admin@192.168.0.100:554/stream

# LLM API 설정
API_BASE_URL=https://api.openai.com/v1
API_KEY=your_api_key_here
MODEL_NAME=gpt-4o-mini

# PyTorch C++ 로그 레벨 (ERROR=NNPACK 경고 억제, INFO=모든 경고 출력)
TORCH_CPP_LOG_LEVEL=ERROR

# 움직임 감지 민감도
SPEED_SLOW=20.0
SPEED_FAST=40.0
DASH_THRESHOLD=15.0
ROTATION_THRESHOLD=45.0
HYSTERESIS=5.0
MIN_FRAMES=3

# YOLO 감지 설정
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.70

# 타일링 감지 설정 (전체화면 감지 실패 시 폴백)
TILE_ENABLED=1
TILE_GRID_X=2
TILE_GRID_Y=2
TILE_OVERLAP=20

# 프레임 스킵 (N개 프레임 중 1개 처리, 0=스킵 없음)
FRAME_SKIP=0

# Vision (LLM 이미지 첨부)
VISION_ENABLED=1
VISION_QUALITY=60
VISION_MAX_WIDTH=1024

# SURGE(급속 가속) 감지 최소 프레임 수
SURGE_MIN_FRAMES=2
