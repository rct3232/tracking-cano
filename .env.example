# LLM API 설정
API_BASE_URL=https://api.openai.com/v1
API_KEY=your_api_key_here
MODEL_NAME=gpt-4o-mini

# 움직임 감지 민감도
SPEED_SLOW=20.0
SPEED_FAST=40.0
DASH_THRESHOLD=15.0
ROTATION_THRESHOLD=45.0
HYSTERESIS=5.0
MIN_FRAMES=3

# YOLO 감지 설정
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.70

# 타일링 감지 설정 (전체화면 감지 실패 시 폴백)
TILE_ENABLED=1
TILE_GRID_X=2
TILE_GRID_Y=2
TILE_OVERLAP=20

# 프레임 스킵 (N개 프레임 중 1개 처리, 0=스킵 없음)
FRAME_SKIP=0

# Vision (LLM 이미지 첨부)
VISION_ENABLED=1
VISION_QUALITY=60
VISION_MAX_WIDTH=1024

# 실행 모드: cv_pipeline(기본) / llm_vision
MODE=cv_pipeline

# LLM Vision-Only 모드 설정
VISION_SNAPSHOT_COUNT=5
VISION_INTERVAL_SECONDS=30

# Vision 2-Layer Architecture 설정
VISION_COLLECT_INTERVAL=0.5   # Batch collector capture interval (seconds)
VISION_COLLECT_COUNT=5        # Per-camera buffer maxlen (sliding window)
VISION_MAX_STALE=10.0         # Buffer entry age limit before marked stale (seconds)
VISION_COOLDOWN_SECONDS=30.0  # Total cooldown after logging start (seconds)
VISION_EARLY_TRIGGER=5.0      # Cooldown offset: actual idle = cooldown - early_trigger

# Log Database (dev: SQLite, prod: PostgreSQL)
DATABASE_URL=sqlite:///logs/tracking.db
LOG_DIR=logs
