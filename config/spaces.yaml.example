# === 카메라 설정 (필수) ===
cameras:
  - id: livingroom
    source: rtsp://admin:admin@192.168.0.100:554/stream   # RTSP URL
    status: active                                          # active | inactive
    target_classes: [cat, person]                           # COCO 클래스명
  - id: hallway
    source: rtsp://admin:admin@192.168.0.101:554/stream
    status: active
    target_classes: [person]
  # 직접 파일 사용 예시:
  # - id: cam_03
  #   source: data/sample.mp4
  #   status: active
  #   target_classes: [cat]

# === 공간 정의 (선택) ===
# spaces:
#   - id: room_living
#     name: 거실
#     cameras: [cam_01]

# === 임계값 설정 (선택 — 생략 시 디폴트 적용) ===
# thresholds:
#   overlap: 0.3        # bbox 겹침률 (IoU)
#   distance: 50        # 중심점 간 거리 (px)
#   speed_slow: 20      # 정지/천천히 이동 기준 (px/frame)
#   speed_fast: 40      # 천천히/빠르게 이동 기준 (px/frame)

