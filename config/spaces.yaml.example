# === 카메라 설정 (필수) ===
cameras:
  - id: livingroom
    source: rtsp://admin:admin@192.168.0.100:554/stream   # RTSP URL
    status: active                                          # active | inactive
    target_classes: [cat, person]                           # COCO 클래스명
    # llm_system_prompt: |                                  # LLM Vision-Only 모드에서 사용
    #   You are a security monitor. Track all objects in target_classes.
    #   Describe their behavior and interactions in the scene.
  - id: hallway
    source: rtsp://admin:admin@192.168.0.101:554/stream
    status: active
    target_classes: [person]
  # 직접 파일 사용 예시:
  # - id: cam_03
  #   source: data/sample.mp4
  #   status: active
  #   target_classes: [cat]

# === 공간 정의 (선택) ===
# spaces:
