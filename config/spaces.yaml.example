#   overlap: 0.3        # bbox 겹침률 (IoU)
#   distance: 50        # 중심점 간 거리 (px)
#   speed_slow: 20      # 정지/천천히 이동 기준 (px/frame)
#   speed_fast: 40      # 천천히/빠르게 이동 기준 (px/frame)

