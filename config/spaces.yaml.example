# === 카메라 설정 (필수) ===
cameras:
  - id: livingroom
    source: go2rtc:livingroom_cam               # go2rtc:스트림명 형식 (GO2RTC_URL /stream?src=... 로 자동 변환)
    status: active                              # active | inactive
    target_classes: [cat, person]               # COCO 클래스명
  - id: hallway
    source: go2rtc:hallway_cam
    status: active
    target_classes: [person]
  # 직접 RTSP 사용 예시:
  # - id: cam_03
  #   source: rtsp://192.168.0.100:554/stream1
  #   status: active
  #   target_classes: [cat]

# === 공간 정의 (선택) ===
# spaces:
#   - id: room_living
#     name: 거실
#     cameras: [cam_01]

# === 임계값 설정 (선택 — 생략 시 디폴트 적용) ===
# thresholds:
#   overlap: 0.3        # bbox 겹침률 (IoU)
#   distance: 50        # 중심점 간 거리 (px)
#   speed_slow: 20      # 정지/천천히 이동 기준 (px/frame)
#   speed_fast: 40      # 천천히/빠르게 이동 기준 (px/frame)

