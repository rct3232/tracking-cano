# === LLM / Vision 설정 ===
llm:
  api_base_url: https://api.openai.com/v1
  model_name: gpt-4o-mini
  vision_enabled: true
  vision_quality: 60        # JPEG 품질 (1-100)
  vision_max_width: 1024    # 이미지 최대 너비
  collect_interval: 0.5     # Batch collector 캡처 간격 (초)
  collect_count: 5          # Camera 버퍼 최대 크기 (sliding window)
  max_stale_threshold: 10.0 # 버퍼 항목 유효 시간 (초)
  json_response_format: true  # response_format={"type": "json_object"} 강제 사용 여부
  log_language: en            # LLM 출력 언어 (iso 639-1 2자리 코드: en, ko, ja 등)
  # snapshot_cooldown: 30     # space snapshot debounce 간격 (초, 기본 5.0)
  # detect_cooldown: 60       # space detect loop 사이클 간 대기 (초, 기본 0=비활성화)

# === 재연결 설정 ===
reconnect:
  max_failures: 5            # 재연결 트리거 전 연속 읽기 실패 횟수
  base_delay: 1.0            # 백오프 시작 간격 (초) - exponential backoff 적용
  max_delay: 300.0           # 최대 재연결 시도 간격 (초, 기본 5분)
  read_backoff: 0.5          # read() 실패 시 대기 시간 (초)
  reconnect_backoff: 2.0     # 재연결 실패 후 추가 대기 시간 (초)
  pts_lag_threshold: 60.0    # PTS 지연 감지 임계값 (초) - 초과 시 강제 재연결

# === 로깅 설정 ===
logging:
  log_dir: logs
  retention_hours: 24       # output/에서 정리할 파일 나이(시간)
  cleanup_enabled: true     # 자동 정리 활성화 여부
  # DATABASE_URL은 .env 또는 환경변수로 설정 (여기서 설정 불가)

# === REST API 설정 ===
api:
  port: 8000

# === 카메라 설정 (multi-camera 모드 필수) ===
# cameras:
#   - id: livingroom
#     source: rtsp://user:pass@192.168.0.68:554/stream2
#     status: active
#     target_classes: [cat]
#     llm_system_prompt: "..."

# === MinIO 스토리지 (선택) ===
# 환경변수만 지원. YAML에서 설정 불가.
# MINIO_ENDPOINT=minio.local:9000
# MINIO_ACCESS_KEY=myaccesskey
# MINIO_SECRET_KEY=mysecretkey123
# MINIO_BUCKET=snapshots  # 기본값
# MINIO_RETENTION_HOURS=24      # 정리 대상 나이(시간)
# MINIO_CLEANUP_ENABLED=true    # 자동 정리 활성화 여부

# === 공간 정의 ===
# spaces:
#   - id: room_livingroom
#     name: 거실
#     cameras: [livingroom, livingfront]
#     llm_system_prompt: "..."
